pipeline {
    agent any

    tools {
        jdk 'jdk-21'
        maven 'maven-3.9.10'
    }

    options {
        timeout(time: 25, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        // Los secretos salen de las credenciales de Jenkins y se muestran como **** en el log
        SPRING_DATASOURCE_PASSWORD = credentials('db-password')
        SONAR_TOKEN                = credentials('sonar-token-cliente')
        SONAR_URL                  = 'http://localhost:9000'
        PROYECTO                   = 'Ejercicio5Cliente'
    }

    stages {
        stage('Versiones') {
            steps {
                bat 'java -version'
                bat 'mvn -v'
            }
        }

        stage('Preparar el Gestor (API)') {
            steps {
                // El puerto 8081 debe estar libre: el pipeline levanta su propio Gestor
                powershell '''
                    if (Get-NetTCPConnection -LocalPort 8081 -State Listen -ErrorAction SilentlyContinue) {
                        throw "El puerto 8081 ya esta ocupado. Cierra el Gestor local antes de correr este pipeline."
                    }
                    exit 0
                '''
                // Las pruebas del Cliente consumen la API real, asi que se empaqueta el Gestor
                dir('Ejercicio5MyAPIGestor') {
                    bat 'mvn -B clean package -DskipTests'
                }
            }
        }

        stage('Pruebas y analisis del Cliente con el Gestor en ejecucion') {
            failFast true
            parallel {
                // Rama 1: el Gestor corre en este paso hasta que la rama 2 lo apaga
                stage('API Gestor en ejecucion') {
                    steps {
                        dir('Ejercicio5MyAPIGestor') {
                            bat returnStatus: true, script: 'java -jar target\\Ejercicio5MyAPIGestor-0.0.1-SNAPSHOT.jar'
                        }
                    }
                }

                // Rama 2: espera al Gestor, prueba el Cliente, analiza y apaga el Gestor
                stage('Cliente') {
                    stages {
                        stage('Esperar al Gestor') {
                            steps {
                                powershell '''
                                    for ($i = 0; $i -lt 60; $i++) {
                                        try {
                                            (New-Object Net.Sockets.TcpClient).Connect("localhost", 8081)
                                            Write-Host "Gestor listo en el puerto 8081"
                                            exit 0
                                        } catch {
                                            Start-Sleep -Seconds 3
                                        }
                                    }
                                    throw "El Gestor no arranco en 3 minutos"
                                '''
                            }
                        }

                        stage('Compilar y probar (JaCoCo)') {
                            steps {
                                dir('Ejercicio5Cliente') {
                                    // clean verify: compila, corre las pruebas contra el Gestor y genera el reporte de JaCoCo
                                    bat 'mvn -B clean verify'
                                }
                            }
                        }

                        stage('Analisis SonarQube') {
                            steps {
                                dir('Ejercicio5Cliente') {
                                    // El analisis excluye las carpetas target y espera el resultado del Quality Gate
                                    bat 'mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:5.5.0.6356:sonar "-Dsonar.projectKey=%PROYECTO%" "-Dsonar.projectName=%PROYECTO%" "-Dsonar.host.url=%SONAR_URL%" "-Dsonar.exclusions=**/target/**" "-Dsonar.qualitygate.wait=true"'
                                }
                            }
                        }

                        stage('Apagar el Gestor') {
                            steps {
                                powershell '''
                                    Get-NetTCPConnection -LocalPort 8081 -State Listen -ErrorAction SilentlyContinue |
                                        ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }
                                    exit 0
                                '''
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            // Respaldo: si algo fallo, el Gestor de este pipeline no se queda encendido
            powershell '''
                Get-NetTCPConnection -LocalPort 8081 -State Listen -ErrorAction SilentlyContinue |
                    ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }
                exit 0
            '''
            junit allowEmptyResults: true, testResults: 'Ejercicio5Cliente/target/surefire-reports/*.xml'
            archiveArtifacts artifacts: 'Ejercicio5Cliente/target/*.jar, Ejercicio5Cliente/target/site/jacoco/**', allowEmptyArchive: true
        }
    }
}
